{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dag-config.schema.json",
  "title": "OpenCode DAG Canvas Config",
  "oneOf": [
    { "$ref": "#/$defs/document" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_file"],
      "properties": {
        "data_file": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataFile"],
      "properties": {
        "dataFile": { "type": "string", "minLength": 1 }
      }
    }
  ],
  "$defs": {
    "scalarMetadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "title", "nodes", "edges"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "subtitle": { "type": "string", "maxLength": 240 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "description": { "type": "string", "maxLength": 500 },
              "color": { "type": "string", "minLength": 1, "maxLength": 32, "default": "cyan" },
              "metadata": { "$ref": "#/$defs/scalarMetadata" }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string", "minLength": 1, "maxLength": 128 },
              "to": { "type": "string", "minLength": 1, "maxLength": 128 },
              "label": { "type": "string", "maxLength": 120, "pattern": "^[^\\r\\n]*$" },
              "color": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "description": "Optional override. Omit it to use the stable generated color shared by edges entering the same target node."
              },
              "metadata": { "$ref": "#/$defs/scalarMetadata" }
            }
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": {
              "enum": ["left-to-right", "top-to-bottom"],
              "default": "left-to-right"
            },
            "minNodeWidth": { "type": "integer", "minimum": 8, "maximum": 48, "default": 12 },
            "maxNodeWidth": { "type": "integer", "minimum": 12, "maximum": 64, "default": 48 },
            "minNodeHeight": { "type": "integer", "minimum": 3, "maximum": 8, "default": 3 },
            "maxNodeHeight": { "type": "integer", "minimum": 3, "maximum": 12, "default": 8 },
            "layerGap": { "type": "integer", "minimum": 4, "maximum": 24, "default": 8, "description": "Minimum layer gap; edge labels and outgoing bend lanes may expand it." },
            "nodeGap": { "type": "integer", "minimum": 1, "maximum": 12, "default": 2 },
            "padding": { "type": "integer", "minimum": 0, "maximum": 8, "default": 2 }
          }
        },
        "metadata": { "$ref": "#/$defs/scalarMetadata" }
      }
    }
  }
}
